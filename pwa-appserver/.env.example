# PWA Platform (snadboy/pwa) — bedrock, port 8200
# Real values live in the shareables .env; copy this to .env alongside the
# compose file on the deploy host. Never commit the filled-in version: this
# repository is PUBLIC.

# Postgres for the pwa-db service (pgvector/pgvector:pg16)
POSTGRES_PASSWORD=

# Voyage AI embeddings — cumulus_ledger smart search (voyageai.com)
VOYAGE_API_KEY=

# Claude — cumulus_ledger RAG answers (console.anthropic.com)
ANTHROPIC_API_KEY=

# Write auth for the bulletin board POST API
BULLETIN_API_KEY=

# plex_recent app
PLEX_URL=
PLEX_TOKEN=
