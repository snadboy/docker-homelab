# pwa-appserver — bedrock, port 8200
#
# This stack no longer reads a .env beside the compose. Both services use
# env_file: with ABSOLUTE paths on the shareables CIFS mount:
#
#   /mnt/shareables/stack-env/pwa-appserver.env   (application)
#   /mnt/shareables/stack-env/pwa-db.env          (postgres only)
#
# Why: an absolute path resolves identically whether the stack is deployed by
# hand from ~/docker-homelab or by Dockhand into /data/stacks, so nothing has to
# place a file beside the compose. Dockhand's env_file_path column stays unused.
#
# Two files rather than one so pwa-db does not carry the ANTHROPIC / VOYAGE /
# PLEX credentials it never reads.
#
# Note the shareables mount is CIFS with a mount-wide file_mode=0755, so chmod
# on these files does not stick — same posture as the existing .claude/.env.
#
# This file documents the required keys only. Real values live on shareables.

# --- /mnt/shareables/stack-env/pwa-appserver.env ---
UPLOAD_DIR=/data/uploads
# Pre-composed so no interpolation is needed in the compose file:
DATABASE_URL=postgresql+asyncpg://pwa:<POSTGRES_PASSWORD>@pwa-db:5432/pwa
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=
BULLETIN_API_KEY=
PLEX_URL=
PLEX_TOKEN=

# --- /mnt/shareables/stack-env/pwa-db.env ---
POSTGRES_USER=pwa
POSTGRES_PASSWORD=
POSTGRES_DB=pwa
