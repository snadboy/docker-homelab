DB_PASSWORD=
# SimpleFIN access URL (https://user:pass@.../simplefin)
SIMPLEFIN_ACCESS_URL=
EXCLUDE_ACCOUNTS=name:Checking USAA Robert
SYNC_TIME=05:30
KUMA_PUSH_URL=
# Claude API key: reads attached statements (empty = attach only)
