# Review queue suggestions (empty = defaults: claude-sonnet-5-5, 150 groups per run, 25 per request)
SUGGEST_MODEL=
SUGGEST_MAX_GROUPS=
SUGGEST_BATCH_SIZE=
# Tailnet logins allowed to use the app, comma-separated (empty = no check)
ALLOWED_USERS=
# Home Assistant webhook that shows bill reminders through SB Notify (empty = no reminders). A secret
HA_NOTIFY_WEBHOOK_URL=
